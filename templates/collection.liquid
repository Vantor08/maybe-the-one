<main class="wrap" style="padding:60px 0;min-height:50vh">
<h1>{{ collection.title }}</h1>
<div class="reviews" style="margin-top:24px">
{% for product in collection.products %}
  <a class="rev" href="{{ product.url }}">{% if product.featured_image %}<img src="{{ product.featured_image | image_url: width: 500 }}" alt="{{ product.title | escape }}" style="width:100%;border-radius:12px">{% endif %}<b>{{ product.title }}</b><span>{{ product.price | money }}</span></a>
{% endfor %}
</div>
</main>
