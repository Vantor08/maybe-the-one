<main class="wrap" style="padding:60px 0;min-height:50vh">
<h1>Search</h1><form action="/search" method="get"><input type="search" name="q" value="{{ search.terms | escape }}" placeholder="Search"></form>{% if search.performed %}<p>{{ search.results_count }} results</p>{% for item in search.results %}<p><a href="{{ item.url }}">{{ item.title }}</a></p>{% endfor %}{% endif %}
</main>
